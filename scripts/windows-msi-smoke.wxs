<?xml version="1.0" encoding="UTF-8"?>
<!--
  A throwaway per-user product that uses the real Flint MSI wizard
  (src-tauri/installer/wix/flint-ui.wxs), so CI can compile and validate it in
  about a minute instead of after the release-grade build. It is not shipped.
  Tauri's own template supplies the real product, and light runs with ICE
  validation there too, so anything this rejects would fail that build.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Flint" UpgradeCode="{6C1B7A20-3D4F-4E55-9B7A-0F2B8E7D4A11}" Language="1033" Manufacturer="Flint MSI UI Smoke" Version="0.9.0">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Keywords="Installer" />
    <Media Id="1" Cabinet="a.cab" EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is installed." AllowSameVersionUpgrades="yes" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
    <SetProperty Id="ARPNOMODIFY" Value="1" After="InstallValidate" Sequence="execute" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="FlintMsiUiSmoke" />
      </Directory>
    </Directory>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="C1" Guid="{A5F1D0C2-1B7E-4B0E-9A1C-6D0E7F8A9B10}">
        <File Id="Path" Source="dummy.exe" KeyPath="no" />
        <RemoveFolder Id="RmInst" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FlintMsiUiSmoke" Name="x" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="F" Title="App" Level="1"><ComponentRef Id="C1" /></Feature>
    <CustomAction Id="LaunchApplication" Impersonate="yes" FileKey="Path" ExeCommand="" Return="asyncNoWait" />
    <UIRef Id="WixUI_Flint" />
  </Product>
</Wix>
