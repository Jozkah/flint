    "pythonw": ["-c"],
    "py": ["-c"],
    "node": ["-e", "--eval", "-p", "--print"],
    "nodejs": ["-e", "--eval", "-p", "--print"],
    "perl": ["-e", "-E"]
  },
  "uncertainCommands": {
    "eval": "`eval` runs text built at run time, which cannot be checked in advance",
    "iex": "`Invoke-Expression` runs text built at run time, which cannot be checked in advance",
    "invoke-expression": "`Invoke-Expression` runs text built at run time, which cannot be checked in advance"
  },
