{
  "$comment": "Canonical data for the destructive-command guard. Read by the Rust agent loop (src-tauri/src/core/agent/destructive.rs, via include_str!) and by the web app (web-app/src/lib/destructiveCommand.ts, via import). Both implementations must give the same verdict for every entry in `cases`; each runtime has a parity test that walks the list. Edit here, not in either implementation. `expect` is `ask` (the command is put to the user) or `allow` (it may run under auto-approval).",
  "wrappers": [
    "sudo",
    "doas",
    "env",
    "command",
    "exec",
    "nohup",
    "time",
    "nice",
    "ionice",
    "stdbuf",
    "builtin",
    "timeout",
    "setsid",
    "chroot",
    "runas"
  ],
  "wrapperValueOptions": {
    "sudo": ["-u", "-g", "-C", "-p", "-h", "-r", "-t", "-U"],
    "doas": ["-u", "-C"],
    "nice": ["-n"],
    "ionice": ["-c", "-n", "-p"],
    "env": ["-u", "-C", "-S"],
    "stdbuf": ["-i", "-o", "-e"],
    "timeout": ["-s", "-k"]
  },
  "wrapperPositional": { "timeout": 1, "chroot": 1 },
  "inlineShells": ["bash", "sh", "zsh", "dash", "ksh", "fish", "busybox"],
  "powershells": ["powershell", "pwsh"],
  "inlineInterpreters": {
    "python": ["-c"],
