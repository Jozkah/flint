{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flint",
        "width": 1200,
        "minWidth": 800,
        "height": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "center": true,
        "transparent": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": [
      "resources/LICENSE",
      "resources/mobile/",
      "resources/bin/flint",
      "resources/bin/flint-llama-worker",
      "resources/bin/libggml*.so*",
      "resources/bin/sqlite-vec.so"
    ],
    "externalBin": [
      "resources/bin/uv"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "usr/bin/bun": "resources/bin/bun"
        }
      },
      "deb": {
        "files": {
          "usr/bin/bun": "resources/bin/bun"
        }
      }
    }
  }
}
