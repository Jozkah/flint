{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flint",
        "width": 1200,
        "minWidth": 800,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "center": true,
        "visible": false,
        "transparent": false,
        "decorations": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": [
      "resources/LICENSE",
      "resources/mobile/",
      "resources/bin/flint.exe",
      "resources/bin/flint-llama-worker.exe",
      "resources/bin/ggml*.dll"
    ],
    "externalBin": [
      "resources/bin/bun",
      "resources/bin/uv"
    ],
    "windows": {
      "wix": {
        "template": "./installer/wix/main.wxs",
        "fragmentPaths": [
          "./installer/wix/flint-ui.wxs"
        ],
        "bannerPath": "./installer/wix/banner.bmp",
        "dialogImagePath": "./installer/wix/dialog.bmp"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "tauri.bundle.windows.nsis.template"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
