{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flint",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "center": true,
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": true,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": [
            "fullScreenUI",
            "mica",
            "tabbed",
            "blur",
            "acrylic"
          ],
          "state": "active"
        },
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "resources/LICENSE",
      "resources/bin/mlx-server",
      "resources/bin/mlx-swift_Cmlx.bundle",
      "resources/bin/flint",
      "resources/bin/flint-llama-worker",
      "resources/bin/libggml*"
    ],
    "externalBin": [
      "resources/bin/bun",
      "resources/bin/uv"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./installer/dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 195 },
        "applicationFolderPosition": { "x": 480, "y": 195 }
      }
    }
  }
}
