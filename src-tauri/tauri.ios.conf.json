{
  "identifier": "jan.ai.app.ios",
  "build": {
    "devUrl": null,
    "frontendDist": "../web-app/dist-ios",
    "beforeDevCommand": "yarn build:ios:shell",
    "beforeBuildCommand": "yarn build:ios:shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flint",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["mobile"]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "iOS": {
      "developmentTeam": "<DEVELOPMENT_TEAM_ID>"
    },
    "resources": [
      "resources/LICENSE"
    ],
    "externalBin": []
  }
}